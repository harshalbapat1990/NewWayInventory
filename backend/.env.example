# Copy these values into a private environment file for local development.
APP_ENV=development
# Production requires unique random values of at least 32 characters:
# SECRET_KEY=
# JWT_SECRET_KEY=
# Production SMTP settings may be managed by finance users after setup.
# SMTP_CREDENTIAL_ENCRYPTION_KEY=generate-with-Fernet
# INVENTORY_DATA_DIR=C:\ProgramData\NewWayInventory
# Production rate limiting requires shared Redis:
# RATELIMIT_STORAGE_URI=rediss://...
# CORS_ORIGINS=https://inventory.example.com
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=
